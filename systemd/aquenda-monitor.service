# Monitor de recursos do Aquenda: CPU, memória e disco a cada 15 s, com alerta em /var/log/aquenda/monitor.log.
# Tolerante a falha: se o processo morrer (kill, erro), o systemd sobe de novo em 5 s, sem limite de tentativas.
[Unit]
Description=Aquenda monitor de CPU, memória e disco
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/aquenda/scripts/03-monitor.sh --servico
Restart=always
RestartSec=5
# prioridade maior que a das aplicações: com a CPU em 100% o monitor ainda precisa medir e alertar
# (com Nice=5, num teste com 2 vCPUs, o stress deixou o monitor 1,5 min sem medir)
Nice=-10
CPUWeight=1000

[Install]
WantedBy=multi-user.target
